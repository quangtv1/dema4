# Bien moi truong cua Notification Gateway (smks-gateway). Chep thanh gateway.env, dien gia tri that,
# DE NGOAI GIT, chi tai khoan chay gateway doc duoc. Chay: smks-gateway --env-file gateway.env serve
# Huong dan: docs/THONG_BAO_TELEGRAM.md muc 4.

TELEGRAM_BOT_TOKEN=THAY-BANG-BOT-TOKEN-TU-BOTFATHER
TELEGRAM_CHAT_ID=THAY-BANG-CHAT-ID-CUA-NHOM

# Khoa dang ky thiet bi: chuoi ngau nhien tu 16 ky tu. May tram ghi khoa nay vao notify.json.
GATEWAY_ENROLL_KEY=THAY-BANG-CHUOI-NGAU-NHIEN-TU-16-KY-TU

GATEWAY_BIND=127.0.0.1:8787
GATEWAY_DATA_DIR=gateway-data

NOTIFICATION_ENABLED=true
DEVICE_REGISTRATION_ENABLED=true
SIGN_NOTIFICATION_ENABLED=true
DOCUMENT_NOTIFICATION_ENABLED=true
FAILURE_NOTIFICATION_ENABLED=true
