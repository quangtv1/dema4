{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sao Mai - Ký số",
  "mainBinaryName": "SaoMai-KySo",
  "identifier": "com.saomaiso.kyso",
  "build": {
    "frontendDist": "../ui/dist/sao-mai-ky-so-ui/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": { "script": "npm start", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sao Mai Ký số",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
