    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:webview:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "allow-app-info",
    "allow-shell-open",
    "allow-merge-inspect-template",
    "allow-merge-read-table",
    "allow-merge-auto-map",
    "allow-merge-plan",
    "allow-merge-preview",
    "allow-merge-preview-template",
    "allow-merge-run",
    "allow-job-cancel",
    "allow-cert-list",
    "allow-token-check",
    "allow-token-forget",
    "allow-pin-saved",
    "allow-pin-forget",
    "allow-driver-status",
    "allow-open-link",
    "allow-sign-list-files",
    "allow-sign-preview",
    "allow-sign-image-preview",
    "allow-sign-positions",
    "allow-sign-layouts",
    "allow-sign-plan-outputs",
    "allow-config-get",
    "allow-config-defaults",
    "allow-config-save",
    "allow-sign-run",
    "allow-verify-file",
    "allow-report-export-pdf",
    "allow-notify-status",
